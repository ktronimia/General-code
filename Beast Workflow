#Install the dependencies

sudo apt install -y wget curl git unzip tar gzip bzip2 build-essential python3 python3-pip python3-venv openjdk-17-jre default-jre libgomp1

# QC
seqkit stats raw_sequences.fasta

# Remove exact sequence duplicates
seqkit rmdup -s raw_sequences.fasta -o unique.fasta

# Alignment
mafft --thread 8 --auto unique.fasta > alignment.fasta

# Alignment statistics
seqkit stats alignment.fasta

# ML phylogeny
iqtree2 \
-s alignment.fasta \
-m MFP \
-B 1000 \
-T AUTO

# BEAST XML
beauti

# BEAST
beast -threads 8 LSDV_BEAST.xml

